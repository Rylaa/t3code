---
import type { ComponentProps } from "astro/types";
import { Image } from "astro:assets";
import iconStable from "../assets/icon.webp";
import iconNightly from "../assets/icon-nightly.webp";
import Layout from "../layouts/Layout.astro";
import { RELEASES_URL } from "../lib/releases";
import { ANDROID_PLAY_STORE_URL, IOS_APP_STORE_URL } from "../lib/site";

const imageProps = {
  alt: "",
  densities: [1, 2, 3],
  format: "webp",
  quality: 90,
  decoding: "async",
} satisfies Partial<ComponentProps<typeof Image>>;
---

<Layout title="Download — T3 Code" description="Download T3 Code for macOS.">
  <div class="download-page" id="download-page" data-channel="stable">
    <!-- The sky lives behind the header and fades to the page. It only shows on the nightly channel. -->
    <header class="download-head">
      <div class="sky" aria-hidden="true"></div>
      <div class="head-inner" data-rise>
        <span class="head-icon">
          <Image class="head-icon--stable" src={iconStable} width={64} height={64} loading="eager" {...imageProps} />
          <Image class="head-icon--nightly" src={iconNightly} width={64} height={64} loading="eager" {...imageProps} />
        </span>
        <h1 class="heading">Download T3 Code</h1>
      </div>
      <div class="channel-toggle" role="tablist" aria-label="Release channel" data-rise style="--d:90ms">
        <span class="channel-thumb" aria-hidden="true"></span>
        <button type="button" role="tab" data-channel="stable" aria-selected="true">Stable</button>
        <button type="button" role="tab" data-channel="nightly" aria-selected="false">Nightly</button>
      </div>
      <p class="head-meta" data-rise style="--d:180ms">
        <a id="changelog-link" class="changelog-link" href={RELEASES_URL} target="_blank" rel="noopener noreferrer">
          <span id="version-label">&nbsp;</span><span aria-hidden="true"> &#8599;</span>
        </a>
      </p>
    </header>

    <div class="platforms">
      <!-- macOS -->
      <section class="platform-section" data-rise style="--d:240ms">
        <div class="platform-header">
          <svg class="platform-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 814 1000" aria-hidden="true"><path fill="currentColor" d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/></svg>
          <h2 class="platform-name">macOS</h2>
        </div>
        <div class="download-cards">
          <a class="download-card" data-asset="arm64.dmg" href={RELEASES_URL}>
            <span class="card-icon">
              <Image class="card-icon--stable" src={iconStable} width={28} height={28} loading="lazy" {...imageProps} />
              <Image class="card-icon--nightly" src={iconNightly} width={28} height={28} loading="lazy" {...imageProps} />
            </span>
            <span class="card-text">
              <span class="card-arch">Apple Silicon (arm64)</span>
              <span class="card-format">.dmg</span>
            </span>
          </a>
        </div>
        <p class="intel-note">
          On an Intel Mac? <a data-asset="x64.dmg" href={RELEASES_URL}>Download the x64 build</a>.
        </p>
      </section>

      <!-- Mobile. Stable only, there is no nightly mobile build. -->
      <section class="platform-section platform-section--mobile" data-rise style="--d:420ms">
        <div class="platform-header">
          <svg class="platform-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="7" y="2" width="10" height="20" rx="2.5"/><path d="M11 18.5h2"/></svg>
          <h2 class="platform-name">Mobile</h2>
        </div>
        <div class="download-cards">
          <a class="download-card" href={IOS_APP_STORE_URL} target="_blank" rel="noopener noreferrer">
            <span class="card-text">
              <span class="card-arch">iPhone &amp; iPad</span>
              <span class="card-format">App Store</span>
            </span>
          </a>
          <a class="download-card" href={ANDROID_PLAY_STORE_URL} target="_blank" rel="noopener noreferrer">
            <span class="card-text">
              <span class="card-arch">Android</span>
              <span class="card-format">Google Play</span>
            </span>
          </a>
        </div>
      </section>

      <section class="platform-section platform-section--cli" data-rise style="--d:420ms">
        <div class="platform-header">
          <svg class="platform-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 7l5 5-5 5M12 17h7"/></svg>
          <h2 class="platform-name">Terminal</h2>
        </div>
        <code class="cli-line cli-line--stable">curl -fsSL https://t3.codes/install.sh | sh</code>
        <code class="cli-line cli-line--nightly">curl -fsSL https://t3.codes/install.sh | T3CODE_CHANNEL=nightly sh</code>
        <p class="cli-note">Or try it once without installing:</p>
        <code class="cli-line cli-line--stable">npx t3@latest</code>
        <code class="cli-line cli-line--nightly">npx t3@nightly</code>
      </section>
    </div>

    <p class="releases-link" data-rise style="--d:480ms">
      All builds are on the{" "}
      <a id="releases-page-link" href={RELEASES_URL} target="_blank" rel="noopener noreferrer">
        GitHub releases page<span aria-hidden="true"> &#8599;</span>
      </a>
    </p>
  </div>
</Layout>

<script>
  import { fetchLatestRelease, RELEASES_URL, NIGHTLY_RELEASES_URL, type ReleaseChannel } from "../lib/releases";

  const page = document.getElementById("download-page")!;
  const versionLabel = document.getElementById("version-label")!;
  const changelogLink = document.getElementById("changelog-link") as HTMLAnchorElement;
  const releasesPageLink = document.getElementById("releases-page-link") as HTMLAnchorElement;
  const tabs = page.querySelectorAll<HTMLButtonElement>(".channel-toggle button");
  // Only release-asset links; mobile store cards have no data-asset and keep their href.
  const cards = page.querySelectorAll<HTMLAnchorElement>("a[data-asset]");

  function readChannel(): ReleaseChannel {
    return new URLSearchParams(location.search).get("channel") === "nightly" ? "nightly" : "stable";
  }

  function relativeAge(iso: string): string {
    const minutes = Math.max(1, Math.round((Date.now() - Date.parse(iso)) / 60_000));
    if (minutes < 60) return `${minutes} minutes ago`;
    const hours = Math.round(minutes / 60);
    if (hours < 48) return `${hours} hours ago`;
    return `${Math.round(hours / 24)} days ago`;
  }

  async function load(channel: ReleaseChannel) {
    const fallback = channel === "nightly" ? NIGHTLY_RELEASES_URL : RELEASES_URL;
    page.dataset.channel = channel;
    tabs.forEach((tab) => tab.setAttribute("aria-selected", String(tab.dataset.channel === channel)));
    releasesPageLink.href = fallback;
    changelogLink.href = fallback;
    versionLabel.textContent = "\u00a0";
    cards.forEach((card) => {
      card.href = fallback;
    });

    try {
      const release = await fetchLatestRelease(channel);
      // A toggle click while the fetch was in flight wins; drop the stale result.
      if (page.dataset.channel !== channel) return;

      // Stable shows its version. Nightly shows how fresh the build is; the tag is noise.
      versionLabel.textContent =
        channel === "nightly"
          ? `Built ${relativeAge(release.published_at)}`
          : release.tag_name;
      if (release.html_url) changelogLink.href = release.html_url;
      cards.forEach((card) => {
        const match = (release.assets ?? []).find((a) => a.name.endsWith(`-${card.dataset.asset}`));
        card.href = match?.browser_download_url ?? fallback;
      });
    } catch {
      if (page.dataset.channel === channel) versionLabel.textContent = "Releases";
    }
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const channel = tab.dataset.channel as ReleaseChannel;
      const url = new URL(location.href);
      if (channel === "nightly") url.searchParams.set("channel", "nightly");
      else url.searchParams.delete("channel");
      history.replaceState(null, "", url);
      load(channel);
    });
  });

  load(readChannel());
</script>

<style>
  .download-page {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 1.5rem 4rem;
  }

  /* ── Header ── */

  .download-head {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 9vh 1.5rem 2.5rem;
    margin-bottom: 2rem;
  }

  /* Sky: the nightly DMG backdrop, masked so it dissolves into the page instead of ending at a line. */
  .sky {
    position: absolute;
    top: -80px;
    bottom: 0;
    /* Break out of the page padding so the sky spans the full viewport width. */
    left: 50%;
    width: 100vw;
    margin-left: -50vw;
    z-index: -1;
    background: url("/nightly-sky.svg") center / cover no-repeat;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 45%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 45%, transparent 100%);
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 0.9s ease, transform 1.4s cubic-bezier(0.2, 0.7, 0.2, 1);
    pointer-events: none;
  }

  .download-page[data-channel="nightly"] .sky {
    opacity: 1;
    transform: none;
  }

  .head-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .head-icon {
    position: relative;
    width: 64px;
    height: 64px;
    flex-shrink: 0;
  }

  /* Both channel icons stay mounted and cross-fade, so the title never moves. */
  .head-icon img,
  .card-icon img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 0.45s ease;
  }

  .head-icon--nightly,
  .card-icon--nightly {
    opacity: 0;
  }

  .download-page[data-channel="nightly"] .head-icon--stable,
  .download-page[data-channel="nightly"] .card-icon--stable {
    opacity: 0;
  }

  .download-page[data-channel="nightly"] .head-icon--nightly,
  .download-page[data-channel="nightly"] .card-icon--nightly {
    opacity: 1;
  }

  .heading {
    font-weight: 500;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  /* ── Channel toggle ── */

  .channel-toggle {
    position: relative;
    display: inline-flex;
    margin-top: 1.5rem;
    padding: 3px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
    transition: border-color 0.45s ease, background 0.45s ease;
  }

  .download-page[data-channel="nightly"] .channel-toggle {
    border-color: rgba(255, 255, 255, 0.22);
    background: rgba(7, 21, 47, 0.5);
  }

  /* The thumb slides between the two tabs; both tabs are the same width. */
  .channel-thumb {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 3px;
    width: calc(50% - 3px);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1), background 0.45s ease;
  }

  .download-page[data-channel="nightly"] .channel-thumb {
    transform: translateX(100%);
    background: rgba(255, 255, 255, 0.16);
  }

  .channel-toggle button {
    position: relative;
    width: 5.5rem;
    padding: 7px 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--fg-muted);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: color 0.25s ease;
  }

  .channel-toggle button:hover,
  .channel-toggle button[aria-selected="true"] {
    color: var(--fg);
  }

  .channel-toggle button[aria-selected="true"] {
    font-weight: 500;
  }

  .head-meta {
    margin-top: 1rem;
    font-size: 0.8rem;
    min-height: 1.2em;
  }

  .changelog-link {
    color: var(--fg-dim);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: color 0.3s ease, text-decoration-color 0.3s ease;
  }

  .changelog-link:hover {
    color: var(--fg);
    text-decoration-color: var(--fg);
  }

  .download-page[data-channel="nightly"] .changelog-link {
    color: #b9bdff;
  }

  /* ── Platforms ── */

  .platforms {
    width: 100%;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .platform-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .download-page[data-channel="nightly"] .platform-section--mobile {
    display: none;
  }

  /* The CLI ships on both trains; only the install command differs. */
  .cli-line--nightly,
  .download-page[data-channel="nightly"] .cli-line--stable {
    display: none;
  }

  .download-page[data-channel="nightly"] .cli-line--nightly {
    display: block;
  }

  .platform-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .platform-icon {
    width: 1.15em;
    height: 1.15em;
    color: var(--fg-muted);
    flex-shrink: 0;
  }

  .platform-name {
    font-weight: 500;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
  }

  .cli-note {
    color: var(--fg-muted);
    font-size: 0.85rem;
    margin-top: 0.5rem;
  }

  .cli-line {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.6rem 0.9rem;
    border-radius: 10px;
    border: 1px solid rgba(105, 111, 234, 0.35);
    background: rgba(21, 20, 67, 0.3);
    color: var(--fg);
  }

  /* ── Download cards ── */

  .download-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }

  .download-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.02);
    transition: background 0.45s ease, border-color 0.45s ease, transform 0.2s ease;
  }

  .download-card:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.15);
    transform: translateY(-1px);
  }

  .download-card:active {
    transform: translateY(0);
  }

  .download-page[data-channel="nightly"] .download-card[data-asset] {
    border-color: rgba(105, 111, 234, 0.4);
    background: linear-gradient(135deg, rgba(81, 101, 216, 0.1), rgba(168, 91, 234, 0.06));
  }

  .download-page[data-channel="nightly"] .download-card[data-asset]:hover {
    border-color: rgba(105, 111, 234, 0.7);
  }

  .card-icon {
    position: relative;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
  }

  .card-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .card-arch {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .card-format {
    font-size: 0.8rem;
    color: var(--fg-dim);
    transition: color 0.45s ease;
  }

  .download-page[data-channel="nightly"] .card-format {
    color: #b6b0ff;
  }

  .intel-note {
    font-size: 0.8rem;
    color: var(--fg-dim);
  }

  .intel-note a,
  .releases-link a {
    color: var(--fg-muted);
    text-decoration: underline;
    text-decoration-color: rgba(161, 161, 170, 0.4);
    text-underline-offset: 3px;
    transition: color 0.3s ease, text-decoration-color 0.3s ease;
  }

  .intel-note a:hover,
  .releases-link a:hover {
    color: var(--fg);
    text-decoration-color: var(--fg);
  }

  /* ── Releases link ── */

  .releases-link {
    margin-top: 3rem;
    font-size: 0.825rem;
    color: var(--fg-dim);
  }

  /* ── Motion ── */

  @media (prefers-reduced-motion: reduce) {
    .sky,
    .head-icon img,
    .card-icon img,
    .channel-thumb,
    .channel-toggle,
    .download-card {
      transition: none;
    }
  }

  /* ── Mobile ── */

  @media (max-width: 640px) {
    .download-page {
      padding: 0 1.25rem 4rem;
    }

    .download-head {
      padding: 6vh 1.25rem 2rem;
    }

    .head-inner {
      flex-direction: column;
      text-align: center;
    }

    .platforms {
      padding: 0 0.25rem;
    }

    .download-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
